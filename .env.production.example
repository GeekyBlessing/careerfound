# Production environment template for the CareerFound backend.
#
# This is a template only — no real values are filled in, and nothing here
# is wired into the live deployment yet. DNS for the production domain
# (mycareerfound.com) is not connected to any host yet. Once a hosting
# platform is chosen (see infra/README.md), copy the values below into
# that platform's environment/secrets configuration — do not commit a
# filled-in copy of this file, and do not put real secrets in plain .env
# files on the server; use your platform's secrets manager instead.

ENVIRONMENT=production

# --- App / domain ---
# Production domain: https://mycareerfound.com
# Comma-separated list — includes both apex and www so either resolves.
FRONTEND_ORIGIN=https://mycareerfound.com,https://www.mycareerfound.com
PUBLIC_APP_URL=https://mycareerfound.com

# --- Database ---
# Point at your managed Postgres instance once one exists (RDS / Render /
# Railway / Fly Postgres / etc — see infra/README.md for options).
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:5432/<db>

# --- Auth / security ---
# Generate a real value with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Store it in your platform's secrets manager, not in a checked-in file.
JWT_SECRET_KEY=<set via secrets manager>
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=43200

# Google OAuth — "Continue with Google" uses Google's client-side token
# flow (no server-side redirect URL involved). If you enable it in
# production, add https://mycareerfound.com and https://www.mycareerfound.com
# to the OAuth client's "Authorized JavaScript origins" in Google Cloud
# Console, then set these two values.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- AI provider ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=<set via secrets manager>
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Payments (Phase 2 integration point, not wired live) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Rate limiting ---
AI_RATE_LIMIT_PER_MINUTE=20
AUTH_RATE_LIMIT_PER_MINUTE=10
