# Copy this file to .env and fill in real values before running
# `docker compose up`. Never commit a real .env file.

# --- App ---
ENVIRONMENT=development

# Comma-separated list of allowed CORS origins. Production domain is
# mycareerfound.com (DNS/hosting not connected yet) — see
# .env.production.example for the production values to use at deploy time.
FRONTEND_ORIGIN=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000

# --- Database ---
# docker-compose overrides this automatically to point at the postgres
# service; only needed here for reference / non-docker local runs.
DATABASE_URL=postgresql+asyncpg://careerfound:careerfound_dev_password@localhost:5432/careerfound

# --- Auth / security ---
# Generate a real value with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=43200

# Google OAuth — leave blank to keep "Continue with Google" disabled in the UI.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- AI provider ---
# "mock" (default) requires no key and returns realistic, structured,
# personalized responses for every AI feature — the whole product works
# end-to-end without this. Set to "anthropic" + provide a key to go live.
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Payments (Phase 2 integration point, not wired live) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Rate limiting ---
AI_RATE_LIMIT_PER_MINUTE=20
AUTH_RATE_LIMIT_PER_MINUTE=10
