# Production environment template for the CareerFound frontend.
#
# Template only — DNS for mycareerfound.com is not connected to any host
# yet. Fill this in (as real platform env vars, e.g. on Vercel/Render, not
# a committed file) once the backend has a public production URL.

# If the backend is hosted on its own subdomain:
# NEXT_PUBLIC_API_URL=https://api.mycareerfound.com/api/v1
#
# If the backend is reverse-proxied under the same domain instead:
# NEXT_PUBLIC_API_URL=https://mycareerfound.com/api/v1
NEXT_PUBLIC_API_URL=https://api.mycareerfound.com/api/v1
